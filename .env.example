# Copy to .env and fill in. No real secret belongs in this file's committed copy.
SECRET_KEY=change-me-to-a-long-random-string
DEV_OTP=false
DATABASE_URL=postgresql://crm:crm@db:5432/crm
# Phase 2 placeholders only (leave empty unless the firm enables live sending).
# Live SMS/email stay OFF until the firm's sender is verified AND a test
# message is received (settings gates in the app) — see README.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
SENDGRID_API_KEY=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
CALENDLY_WEBHOOK_SECRET=
AI_PROVIDER=template
ALLOW_TEST_HOOKS=false
# Phase 4 placeholder only (leave empty). Card payments are RECORDED, not
# charged: live Stripe charging is not implemented in this build, so no
# Stripe credential is ever needed or shipped here.
STRIPE_SECRET_KEY=
# Inbound Meta webhooks (WhatsApp + Facebook/Instagram -> leads).
# The webhook URL is <public-base>/api/webhooks/meta. Set META_VERIFY_TOKEN
# to the same verify token entered in Meta's webhook subscription, and
# META_APP_SECRET to the Meta app secret. META_PAGE_TOKEN is optional: only
# needed for Lead Ads detail fetch; without it, leadgen events still create
# stub leads so nothing is lost. Never commit real values here.
META_VERIFY_TOKEN=
META_APP_SECRET=
META_PAGE_TOKEN=
